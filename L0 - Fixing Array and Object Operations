const library = {
  books: [
    { title: "The Hobbit", author: "J.R.R. Tolkien", year: 1937 }
  ],

  addBook(book) {
    if (!book.title || !book.author || !book.year) {
      console.log("Book information is incomplete.");
      return;
    }
    this.books.push(book);
  },

  findBookByTitle(title) {
    return this.books.find(book => book.title === title);
  },

  removeBookByTitle(title) {
    const index = this.books.findIndex(book => book.title === title);
    if (index !== -1) {
      this.books.splice(index, 1);
      console.log(`Book titled "${title}" removed.`);
    } else {
      console.log("Book not found.");
    }
  }
};

// Example operations
library.addBook({ title: "1984", author: "George Orwell", year: 1949 });
console.log("Total books:", library.books.length); // Should be 2
console.log("Finding 1984:", library.findBookByTitle("1984")); // Should return the book
library.removeBookByTitle("1984"); // Should remove the book
console.log("Total books after removal:", library.books.length); // Should be 1

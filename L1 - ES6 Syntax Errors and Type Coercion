const checkout = {
  items: [],
  total: 0,

  addItem(item) {
    // Convert price to a number and validate
    const price = parseFloat(item.price);

    if (isNaN(price)) {
      console.log("Invalid price.");
      return;
    }

    item.price = price;
    this.items.push(item);
    this.total += price;
  },

  getTotal() {
    return `Total: $${this.total.toFixed(2)}`;
  }
};

// Test cases
checkout.addItem({ name: "Coffee Maker", price: "99.99" });  // valid string price
checkout.addItem({ name: "Milk", price: 3.50 });              // valid numeric price
checkout.addItem({ name: "Broken Item", price: "abc" });      // invalid price

console.log(checkout.getTotal()); // Should show Total: $103.49
